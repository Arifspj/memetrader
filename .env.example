# ---------- app ----------
APP_ENV=dev
SECRET_KEY=change-me
API_BASE_URL=http://localhost:8000

# ---------- database ----------
# Postgres (docker compose) or sqlite+aiosqlite for local
DATABASE_URL=postgresql+asyncpg://memetrader:memetrader@localhost:5432/memetrader
# DATABASE_URL=sqlite+aiosqlite:///./memetrader.db

# ---------- redis (optional in paper mode) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- solana ----------
# devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
# Helius dedicated node (optional, free tier works)
HELIUS_API_KEY=

# ---------- market data ----------
# DexScreener needs no key
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest/dex
DEXSCREENER_CACHE_TTL=10

# ---------- execution ----------
# jupiter | paper
EXECUTION_MODE=paper
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
JUPITER_API_KEY=

# ---------- ai (optional context layer only) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- trading defaults ----------
STARTING_CAPITAL_USD=1000
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=5.0
TAKE_PROFIT_PCT=12.0
STOP_LOSS_PCT=6.0
TRAILING_ACTIVATION_PCT=8.0
TRAILING_DROP_PCT=4.0
MAX_HOLD_MINUTES=240
SCAN_INTERVAL_SECONDS=20
MIN_ENTRY_SCORE=80
REENTRY_COOLDOWN_MINUTES=15
